{
    "compilerOptions": {
        "allowJs": true,
        "strict": true,
        "target": "ES6",
        "module": "ES6",
        "moduleResolution": "node",
        "sourceMap": true,
        "jsx": "react",
        "noUnusedLocals": true,
        "allowUnreachableCode": false,
        "typeRoots": [
            "./node_modules",
            "./node_modules/@types"
        ],
        "outDir": "build",
        "types": [
            "@manycore/idp-sdk"
        ]
    }
}
