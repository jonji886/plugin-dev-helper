      "category": "api_lookup",
      "description": "实现退出当前小程序的函数。",
      "initial_project": "fixtures/T01-exit-miniapp",
      "reference_solution": "solutions/T01/vm.ts",
      "task_prompt": "在 vm.ts 中实现 exitMiniapp 函数：调用酷家乐插件 SDK 提供的退出小程序 API。",
      "expected_behavior": "调用 IDP.Miniapp.exit()，无参数，返回 void。",
      "reference_symbols": [
        "IDP.Miniapp.exit"
      ],
      "mcp_tools_expected": [
        "get_api",
        "search_docs"
      ],
      "acceptance": {
        "typecheck": true,
        "build": true,
        "initial_expect_fail": true,
        "tests": [
          "contains:IDP.Miniapp.exit"
        ]
      },
      "tool_expectation": {
        "required_tools": [
          "get_api",
          "search_docs"
        ],
        "optional_tools": [],
        "acceptable_tool_sets": [
