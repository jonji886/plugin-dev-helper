# DeepSeek API Key (required)
DEEPSEEK_API_KEY=your-api-key-here

# Frontend API base URL for the Next.js app.
# Leave unset to use http://localhost:8000 in local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed to call the FastAPI service, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# HuggingFace offline mode (optional, set to 1 for offline)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
