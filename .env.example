# Preferred: SiliconFlow OpenAI-compatible relay.
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_API_KEY=your-siliconflow-api-key-here

# Four-role model strategy. Values are SiliconFlow model IDs.
# ROUTER: intent classification; MAIN: regular QA; REASON: code/high-complexity;
# VISION: image understanding. The provider defaults to SiliconFlow when omitted.
ROUTER=Qwen/Qwen3-8B
MAIN=deepseek-ai/DeepSeek-V4-Flash
REASON=Pro/zai-org/GLM-5.1
VISION=Qwen/Qwen3-VL-32B-Instruct

# Legacy three-profile compatibility (used only when no four-role variable is set).
# MODEL_DEEPSEEK=deepseek-ai/DeepSeek-V4-Flash
# MODEL_QWEN=Qwen/Qwen2.5-72B-Instruct
# MODEL_GLM=Pro/zai-org/GLM-5.1

# Legacy direct-provider compatibility (optional).
# DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# Frontend API base URL for the Next.js app.
# Leave unset to use http://localhost:8000 in local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Origins allowed to call the FastAPI service, comma-separated.
FRONTEND_ORIGINS=http://localhost:3000

# Runtime tuning (optional)
RETRIEVAL_TOP_K=5
# Maximum evidence characters sent to Main/Reason/Vision; lower this if the relay is slow.
ANSWER_CONTEXT_MAX_CHARS=6000
# Main/Reason/Vision calls may need a bounded 60s relay timeout; Router has a separate budget below.
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
# Router is a lightweight classifier: keep its failure budget bounded.
ROUTER_TIMEOUT_SECONDS=15
ROUTER_MAX_RETRIES=0
ROUTER_MAX_TOKENS=256
PROMPT_VERSION=v1

# Optional Langfuse tracing. Disabled by default and never required by /api/chat.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Application-level model routing overrides (optional).
# ROLE_PROVIDER / ROLE_MODEL can override the shared SiliconFlow provider:
# ROUTER_PROVIDER=siliconflow
# ROUTER_MODEL=Qwen/Qwen3-8B
# MAIN_PROVIDER=siliconflow
# MAIN_MODEL=deepseek-ai/DeepSeek-V4-Flash
# REASON_PROVIDER=siliconflow
# REASON_MODEL=Pro/zai-org/GLM-5.1
# VISION_PROVIDER=siliconflow
# VISION_MODEL=Qwen/Qwen3-VL-32B-Instruct
# Legacy DEFAULT/FAST/STRONG_LLM_* variables remain supported.
# APP_DATABASE_PATH=./data/app.sqlite3
# DATA_DIR=./data
# CHROMA_PATH=./data/chroma
# KNOWLEDGE_PATH=./data/knowledge
# GRAPH_PATH=./data/graph/dependency_graph.json

# HuggingFace offline mode (optional, set to 1 for offline)
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
